@model IEnumerable<SalesWebMVCProject.Models.SalesRecord>
@{
    ViewData["Title"] = "Simple Search";
}
<h2>@ViewData["Title"]</h2>

<nav class="navbar navbar-dark bg-primary p-3 mb-3 rounded">
    <div class="container-fluid">
        <form class="row g-3 align-items-end" role="search">
            <div class="col-auto">
                <label for="minDate" class="form-label text-white">Min Date</label>
                <input type="date" class="form-control" name="minDate" value="@ViewData["minDate"]" />
            </div>
            <div class="col-auto">
                <label for="maxDate" class="form-label text-white">Max Date</label>
                <input type="date" class="form-control" name="maxDate" value="@ViewData["maxDate"]" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-light">Filter</button>
            </div>
        </form>
    </div>
</nav>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h3 class="card-title">Total sales = @Model.Sum(obj => obj.Amount).ToString("F2")</h3>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr class="table-primary">
                    <th>@Html.DisplayNameFor(model => model.Id)</th>
                    <th>@Html.DisplayNameFor(model => model.Date)</th>
                    <th>@Html.DisplayNameFor(model => model.Seller)</th>
                    <th>@Html.DisplayNameFor(model => model.Seller.Department)</th>
                    <th>@Html.DisplayNameFor(model => model.Amount)</th>
                    <th>@Html.DisplayNameFor(model => model.Status)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Id)</td>
                        <td>@Html.DisplayFor(modelItem => item.Date)</td>
                        <td>@Html.DisplayFor(modelItem => item.Seller.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Seller.Department.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Amount)</td>
                        <td>@Html.DisplayFor(modelItem => item.Status)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>