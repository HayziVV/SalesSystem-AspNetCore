@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-5">
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm text-center border">
        <h1 class="display-3 text-primary fw-bold">Sales Web MVC</h1>
        <p class="col-md-8 fs-4 mx-auto text-muted">A modern solution for managing your sales team, departments, and generating performance reports in real-time.</p>
        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center mt-4">
            <a href="/SalesRecords" class="btn btn-primary btn-lg px-4 gap-3">View Sales Reports</a>
            <a href="/Sellers/Create" class="btn btn-outline-secondary btn-lg px-4">New Seller</a>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4 mt-3">
        <div class="col">
            <div class="card h-100 shadow-sm border-primary">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h5 class="card-title mb-0 fw-bold">🏢 Departments</h5>
                </div>
                <div class="card-body">
                    <p class="card-text text-muted">Organize your business structure by creating, editing, and managing different departments.</p>
                </div>
                <div class="card-footer bg-transparent border-0 px-3 pb-3">
                    <a href="/Departments" class="btn btn-outline-primary w-100">Manage Departments</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm border-success">
                <div class="card-header bg-success text-white text-center py-3">
                    <h5 class="card-title mb-0 fw-bold">👤 Sellers Team</h5>
                </div>
                <div class="card-body">
                    <p class="card-text text-muted">Keep track of your sales force. Manage profiles, associate with departments, and monitor salary metrics.</p>
                </div>
                <div class="card-footer bg-transparent border-0 px-3 pb-3">
                    <a href="/Sellers" class="btn btn-outline-success w-100">Manage Sellers</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm border-warning">
                <div class="card-header bg-warning text-white text-center py-3">
                    <h5 class="card-title mb-0 fw-bold">📊 Business Intelligence</h5>
                </div>
                <div class="card-body">
                    <p class="card-text text-muted">Generate powerful insights. Filter sales records by date and view grouped results by department.</p>
                </div>
                <div class="card-footer bg-transparent border-0 px-3 pb-3">
                    <a href="/SalesRecords" class="btn btn-outline-warning w-100">Generate Reports</a>
                </div>
            </div>
        </div>
    </div>
</div>